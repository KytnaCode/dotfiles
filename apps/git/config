[alias]
co = checkout
st = status
a = add
r = reset
br = branch
rb = rebase
cont = rebase --continue

[core]
eol = lf
excludesfile = ~/.gitignore

[credential]
helper = manager 
credentialStore = secretservice

[init]
defaultBranch = main

[push]
autoSetupRemote = true

[user]
name = kytnacode
email = kytnacode@gmail.com
